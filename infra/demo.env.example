# Copy to infra/demo.env and fill in. infra/demo.env stays out of Git.
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RESOURCE_GROUP=my-existing-resource-group
LOCATION=swedencentral

# Globally unique; also the custom subdomain of the Foundry endpoint.
ACCOUNT_NAME=delivery-demo-foundry-1234
PROD_PROJECT=agents-prod
DEV_PROJECT=agents-dev

MODEL_NAME=gpt-5.4-mini
MODEL_VERSION=2026-03-17
MODEL_DEPLOYMENT=gpt-5.4-mini
MODEL_CAPACITY=10

IDENTITY_NAME=id-delivery-demo-pipeline
GITHUB_REPO=owner/foundry-delivery-demo

# Monthly budget in the billing currency of the subscription. Alerts go to the resource group owners.
BUDGET_NAME=foundry-delivery-demo
BUDGET_AMOUNT=30
TAG=demo=foundry-delivery
